---
import Base from "../layouts/Base.astro";
---
<Base
  title="Page not found | Hearts for Henna"
  noindex
  bodyStyle="margin:0;min-height:100vh;min-height:100dvh;display:grid;place-items:center;background:var(--burgundy);color:var(--white);text-align:center;padding:2rem 16px"
>
  <div class="box">
    <img src="/logo.png" alt="Hearts for Henna logo">
    <div class="title"><span class="lead">Oops,</span><h2>Page not found</h2></div>
    <p>This page doesn't exist or has moved.</p>
    <a class="pill light" href="/">Back to home</a>
  </div>
</Base>

<style is:global>
  .box{display:grid;justify-items:center;gap:1.2rem;max-width:30rem}
  .box img{width:9rem;height:9rem;border-radius:50%}
  .box .title{justify-items:center;margin:0}
  .box .title .lead{color:var(--blush)}
  .box .title h2{color:var(--white);margin-left:0}
  .box p{color:#F2DCD6}
</style>
